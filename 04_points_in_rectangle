const r = require("raylib");

function setup(WIDTH, HEIGHT, title, FPS) {
  r.InitWindow(WIDTH, HEIGHT, title);
  r.SetTargetFPS(FPS);

  const screen = { width: WIDTH, height: HEIGHT };
  const noOfPoints = 200;
  const start = { x: WIDTH / 2 - 200, y: HEIGHT / 2 - 100 };
  const end = { x: WIDTH / 2 + 200, y: HEIGHT / 2 + 100 };

  const position = getRandomPoints(start, end, noOfPoints);

  return { start, end, position, screen };
}

function getRandomPoints(start, end, noOfPoints) {
  const points = [];

  for (let i = 0; i < noOfPoints; i++) {
    const randomCenter = {
      x: getRandom(start.x, end.x),
      y: getRandom(start.y, end.y),
    };

    points.push(randomCenter);
  }

  return points;
}

function getRandom(rangeStart, rangeEnd) {
  return Math.random() * (rangeEnd - rangeStart) + rangeStart;
}

function draw(world) {
  r.BeginDrawing();
  r.ClearBackground(r.DARKBLUE);

  const color = {
    r: 255,
    g: 255,
    b: 255,
    a: 100,
  };

  for (const center of world.position) {
    r.DrawCircleV(center, 10, color);
  }

  const cornerA = {
    x: world.start.x,
    y: world.start.y,
  };

  const cornerB = {
    x: world.end.x,
    y: world.start.y,
  };

  const cornerC = {
    x: world.end.x,
    y: world.end.y,
  };

  const cornerD = {
    x: world.start.x,
    y: world.end.y,
  };

  r.DrawLineEx(cornerA, cornerB, 2, r.WHITE);
  r.DrawLineEx(cornerB, cornerC, 2, r.WHITE);
  r.DrawLineEx(cornerC, cornerD, 2, r.WHITE);
  r.DrawLineEx(cornerD, cornerA, 2, r.WHITE);

  r.EndDrawing();
}

function loop(world) {
  while (!r.WindowShouldClose()) {
    draw(world);
  }
}

function tearDown() {
  r.CloseWindow();
}

function main() {
  const WIDTH = 1000;
  const HEIGHT = 600;
  const title = "Points in rectangle";
  const FPS = 60;

  const world = setup(WIDTH, HEIGHT, title, FPS);
  loop(world);

  tearDown();
}

main();
